def search_input(args, dest, sorter, offset, rows, filters=""):
    loc = {"destType": dest["dest_type"], "destId": int(dest["dest_id"])}
    if dest.get("search_string"):
        loc["searchString"] = dest["search_string"]
    return {"location": loc, "dates": {"checkin": args.checkin, "checkout": args.checkout},
            "nbRooms": args.rooms, "nbAdults": args.adults, "nbChildren": len(args.children),
            "childrenAges": list(args.children), "pagination": {"rowsPerPage": rows, "offset": offset},
            "filters": {"selectedFilters": filters} if filters else {},
            "sorters": {"selectedSorter": sorter, "referenceGeoId": None, "tripTypeIntentId": None},
            "doAvailabilityCheck": False, "needsRoomsMatch": False, "useSearchParamsFromSession": False,
            "showAparthotelAsHotel": True, "enableCampaigns": True, "travelPurpose": 2,
            "optionalFeatures": {"forceArpExperiments": True, "testProperties": False},
            "webSearchContext": {"reason": "CLIENT_SIDE_UPDATE", "source": "SEARCH_RESULTS",
                                 "outcome": "SEARCH_RESULTS"},
            "metaContext": {"metaCampaignId": 0}, "merchInput": {"testCampaignIds": []}, "seoThemeIds": []}


def run_search(cl, args, dest, sorter, offset, rows, filters=""):
    d = cl.gql(SEARCH_Q, {"input": search_input(args, dest, sorter, offset, rows, filters)}, "BookingCliSearch")
    s = (d.get("searchQueries") or {}).get("search")
    if not s:
        raise ApiError("search returned no data")
    return s


def iso_day(s):
    return (s or "")[:10] or None


def parse_card(r, nights, args, currency):
    b = r.get("basicPropertyData") or {}
    p = r.get("priceDisplayInfoIrene") or {}
    total = ((p.get("displayPrice") or {}).get("amountPerStay") or {}).get("amountUnformatted")
    total = total if isinstance(total, (int, float)) and total > 0 else None
    cur = ((p.get("displayPrice") or {}).get("amountPerStay") or {}).get("currency") or currency
    charges = (p.get("chargesInfo") or {}).get("translation") or ""
    exc = p.get("excludedCharges") or {}
    exc_amt = ((exc.get("excludeChargesAggregated") or {}).get("amountPerStay") or {}).get("amountUnformatted")
    exc_list = [x for x in exc.get("excludeChargesList") or [] if x.get("chargeInclusion") == "EXCLUDED"]
    blocks = r.get("blocks") or []
    star = b.get("starRating") or {}
    rev = b.get("reviews") or {}
    loc = r.get("location") or {}
    units = ((r.get("matchingUnitConfigurations") or {}).get("unitConfigurations") or [])
    room = " + ".join((f"{u['nbUnits']}× " if (u.get("nbUnits") or 1) > 1 else "") + (u.get("name") or "?")
                      for u in units) or None
    meals = [m for m in [r.get("mealPlanIncluded")] + [x.get("mealPlanIncluded") for x in blocks] if m]
    left = next((x["onlyXLeftMessage"].get("translation") for x in blocks if x.get("onlyXLeftMessage")), None)
    fcu = [x.get("freeCancellationUntil") for x in blocks]
    disc = [x.get("productId") or "" for x in p.get("discounts") or []]
    cc = (b.get("location") or {}).get("countryCode")
    return {
        "id": str(b.get("id") or ""),
        "name": (r.get("displayName") or {}).get("text"),
        "stars": star.get("value") or None,
        "stars_kind": {"STARS": "official", "TILES": "booking_estimate", "SQUARES": "booking_estimate"}.get(
            star.get("symbol"), star.get("symbol")) if star.get("value") else None,
        "rating": rev.get("totalScore") or None,
        "reviews": rev.get("reviewsCount") or None,
        "area": loc.get("displayLocation"),
        "distance": loc.get("mainDistance") or loc.get("publicTransportDistanceDescription"),
        "price_total": rnd(total),
        "price_per_night": rnd(total / nights) if total else None,
        "currency": cur,
        "taxes_included": "含稅" in charges,
        "charges_note": charges or None,
        "extra_charges_possible": bool(exc_list) or "額外費用" in charges,
        "excluded_charges": rnd(exc_amt),
        "room": room,
        "units": sum((u.get("nbUnits") or 1) for u in units) or None,
        "free_cancellation": bool((r.get("policies") or {}).get("showFreeCancellation")) or
        (bool(fcu) and all(fcu)),
        "free_cancel_until": iso_day(min(fcu)) if fcu and all(fcu) else None,
        "no_prepayment": bool((r.get("policies") or {}).get("showNoPrepayment")),
        "breakfast": any(m.get("mealPlanType") or m.get("text") for m in meals),
        "meal": next((m.get("text") for m in meals if m.get("text")), None),
        "genius": any(x.startswith("genius") for x in disc),
        "rooms_left": left,
        "sponsored": bool(r.get("showAdLabel") or r.get("sponsoredListingData")),
        "outside_area": bool((r.get("persuasion") or {}).get("autoextended")),
        "available": total is not None and not (r.get("soldOutInfo") or {}).get("isSoldOut"),
        "page_name": b.get("pageName"),
        "country": cc,
        "url": hotel_url(cc, b.get("pageName"), args) if cc and b.get("pageName") else None,
    }


def search_filters(args):
    f = [f"class={s}" for s in args.stars or []]
    if args.free_cancel:
        f.append("fc=2")
    if args.breakfast:
        f.append("mealplan=1")
    return ";".join(f)


MAX_CALLS = 12


def single_hotel_card(cl, hid, args, nights):
    """destType HOTEL search with 1 row -> the hotel's own card (measured: the cheapest rate)."""
    s = run_search(cl, args, {"dest_type": "HOTEL", "dest_id": str(hid)}, None, 0, 1)
    for r in s.get("results") or []:
        if str((r.get("basicPropertyData") or {}).get("id")) == str(hid):
            return parse_card(r, nights, args, cl.currency)
    return None


def cmd_search(args):
    if args.limit < 1 or args.page < 1:
        raise Usage("--limit and --page must be >= 1")
    _, _, nights = stay(args)
    sort_key = args.sort or "recommended"
    price_sort = sort_key in ("price", "price-desc")
    offset, need = (args.page - 1) * args.limit, args.page * args.limit
    # Every page is cut from one pool read from offset 0 in this run, so page N never repeats
    # pages 1..N-1 of the same run (Booking's own offsets shift while availability changes: the
    # total moved 64..67 within minutes). Price sorts read --pool hotels and re-sort them,
    # because Booking's price order is not monotonic (measured).
    want = max(args.pool, need) if price_sort else need
    filters = search_filters(args)
    dropped = {"sponsored": 0, "duplicate": 0, "outside_area": 0, "no_price": 0, "price_filter": 0}
    with Client(args) as cl:
        dest = resolve_destination(cl, args.destination)
        pool, seen = [], set()
        total_count, calls, meta, exhausted = None, 0, {}, False
        # Booking's own order moves between calls (measured: 1 of 20 Taipei hotels reappeared on
        # page 2 of a later run), so the pool is cached for POOL_TTL and later pages of the same
        # query are cut from the same pool. --fresh re-reads it.
        key = hashlib.md5(json.dumps([dest["dest_type"], dest["dest_id"], args.checkin, args.checkout,
                                      args.adults, args.children, args.rooms, sort_key, filters, args.min,
                                      args.max, cl.currency, want if price_sort else 0, args.include_nearby,
                                      signed_in(cl.st.get("cookies"))]).encode()).hexdigest()
        cache_file = os.path.join(CACHE_DIR, key + ".json")
        cached = None
        if not args.fresh:
            try:
                with open(cache_file, encoding="utf-8") as f:
                    c = json.load(f)
                if time.time() - c["at"] < POOL_TTL:
                    cached = c
            except (OSError, ValueError, KeyError):
                cached = None
        if cached:  # same pool as the earlier page; read further only if this page needs more
            pool, dropped, total_count, meta = cached["pool"], cached["dropped"], cached["total"], cached["meta"]
            calls, exhausted, seen = cached["calls"], cached["exhausted"], set(cached["seen"])
        resumed_at = calls
        while not exhausted and len(pool) < want and calls < MAX_CALLS:
            s = run_search(cl, args, dest, SORTS[sort_key], calls * ROWS, ROWS, filters)
            calls += 1
            meta = s.get("searchMeta") or meta
            total_count = (s.get("pagination") or {}).get("nbResultsTotal", total_count)
            cards = [x for x in s.get("results") or [] if x.get("__typename") == "SearchResultProperty"]
            for h in cards:
                r = parse_card(h, nights, args, cl.currency)
                if r["sponsored"]:
                    dropped["sponsored"] += 1
                    continue
                if not r["id"] or r["id"] in seen:
                    dropped["duplicate"] += 1
                    continue
                seen.add(r["id"])
                if r["outside_area"] and not args.include_nearby:
                    # Booking "auto-extends" to nearby areas when few hotels match (measured: 心齋橋 +
                    # 4-star + breakfast + free cancel = 4 in the district, 82 up to 21 km away)
                    dropped["outside_area"] += 1
                    continue
                if not r["available"]:
                    dropped["no_price"] += 1
                    continue
                if (args.min is not None and r["price_per_night"] < args.min) or \
                        (args.max is not None and r["price_per_night"] > args.max):
                    dropped["price_filter"] += 1
                    continue
                pool.append(r)
            if len(cards) < ROWS or calls * ROWS >= (total_count or 0):
                exhausted = True
                break
        if not cached or calls > resumed_at:
            try:
                os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
                with open(cache_file, "w", encoding="utf-8") as f:
                    json.dump({"at": cached["at"] if cached else time.time(), "pool": pool, "dropped": dropped,
                               "total": total_count, "meta": meta, "exhausted": exhausted, "calls": calls,
                               "seen": sorted(seen)}, f, ensure_ascii=False)
            except OSError:
                pass
        if price_sort:
            pool.sort(key=lambda r: (r["price_total"], r["id"]), reverse=(sort_key == "price-desc"))
        items = pool[offset:need]
        if args.verify:  # cheapest rate of each shown hotel (destType HOTEL search, 1 small call per row)
            for r in items:
                try:
                    c = single_hotel_card(cl, r["id"], args, nights)
                except (ApiError, Blocked) as e:
                    r["verified"] = {"error": str(e)}
                    continue
                r["verified"] = {"lowest_total": c and c["price_total"], "room": c and c["room"],
                                 "free_cancellation": c and c["free_cancellation"], "bookable": bool(c and c["available"]),
                                 "matches_search": bool(c) and c["price_total"] == r["price_total"]}
    out = {"destination": args.destination, "matched": dest["name"], "dest_type": dest["dest_type"],
           "dest_id": dest["dest_id"], "checkin": args.checkin, "checkout": args.checkout, "nights": nights,
           "adults": args.adults, "children": args.children, "rooms": args.rooms, "sort": sort_key,
           "filters": filters or None, "page": args.page, "count": len(items), "matched_total": total_count,
           "in_area_total": (meta.get("availabilityInfo") or {}).get("totalAvailableNotAutoextended"),
           "genius_level": meta.get("geniusLevel"), "site_calls": calls - resumed_at,
           "pool_from_cache": bool(cached), "pool_age_s": int(time.time() - cached["at"]) if cached else 0,
           "dropped": dropped,
           "price_basis": "price_total = the total Booking shows on the card (總金額) for the whole stay and party "
                          "(all rooms, all nights). taxes_included=true when the card says 含稅費及其他費用; "
                          "extra_charges_possible=true when Booking says 可能產生額外費用 (a charge such as a city "
                          "tax is EXCLUDED and paid on top; excluded_charges is its amount when Booking knows it). "
                          "price_per_night = price_total / nights. Sorting uses price_total only. The card can be "
                          "a flexible rate while a cheaper (e.g. non-refundable) rate exists: use --verify, "
                          "`booking hotel` or `booking price` for the cheapest.",
           "paging_note": None if not price_sort else
           f"price sorts rank the first {len(pool)} priced hotels of Booking's own price order, re-sorted by "
           "price_total; --page is a window over that pool (Booking's order is not monotonic, so a cheaper "
           "hotel can exist beyond the pool when matched_total is larger; raise --pool to look further).",
           "notes": cl.notes or None,
           "items": items}

    def human():
        head = (f"matched: {dest['name']} [{dest['dest_type'].lower()}:{dest['dest_id']}], {out['in_area_total']} hotels in area "
                f"({total_count} incl. nearby), "
                f"{nights} night(s), page {args.page}, Genius {meta.get('geniusLevel')}; "
                f"total = stay total for the party, card price")
        rows = []
        for r in items:
            flags = (("免取消 " if r["free_cancellation"] else "") + ("含早 " if r["breakfast"] else "")
                     + ("Genius " if r["genius"] else "") + ("+稅費 " if r["extra_charges_possible"] else "")
                     + ("" if r["taxes_included"] or r["extra_charges_possible"] else "?稅 "))
            row = [r["id"], clip(r["name"], 30), r["stars"] or "", f"{r['rating'] or ''}({r['reviews'] or 0})",
                   money(r["price_total"], r["currency"]), money(r["price_per_night"], r["currency"]),
                   clip(r["room"], 18), flags.strip(), clip(r["area"], 14)]
            if args.verify:
                v = r["verified"]
                row.append("ERR" if v.get("error") else "ok" if v.get("matches_search") else
                           "SOLD OUT" if not v.get("bookable") else "low " + money(v.get("lowest_total"), r["currency"]))
            rows.append(row)
        return head + "\n" + table(rows, ["id", "name", "★", "rating", "total", "/night", "room", "flags", "area"]
                                   + (["verified"] if args.verify else [])) + f"\ndropped: {dropped}"
    return emit(ok(out), args.json, human)


