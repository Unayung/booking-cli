def ld_json(html):
    for m in re.finditer(r'<script type="application/ld\+json"[^>]*>(.*?)</script>', html, re.S):
        try:
            d = json.loads(m.group(1))
        except ValueError:
            continue
        if isinstance(d, dict) and d.get("@type") in ("Hotel", "LodgingBusiness", "Hostel", "Apartment",
                                                      "BedAndBreakfast", "Resort", "Motel"):
            return d
    return {}


def js_array(html, var):
    i = html.find(var + ":")
    if i < 0:
        return None
    try:
        return json.JSONDecoder().raw_decode(html[i + len(var) + 1:].lstrip())[0]
    except ValueError:
        return None


def zh_date(s):
    m = re.search(r"(\d{4})年(\d{1,2})月(\d{1,2})日", s or "")
    return f"{m.group(1)}-{int(m.group(2)):02d}-{int(m.group(3)):02d}" if m else None


def parse_hprt(html):
    """Rows of the room table the page shows: block id -> fit/conditions/beds/occupancy text."""
    i = html.find('id="hprt-table"')
    if i < 0:
        return {}
    t = html[i:html.find("</table>", i)]
    rows, last_beds, last_room = {}, None, None
    for m in re.finditer(r'<tr\s+data-block-id="([^"]+)"(.*?)>(.*?)</tr>', t, re.S):
        bid, attrs, body = m.group(1), m.group(2), m.group(3)
        fm = re.search(r'data-fltrs="([^"]*)"', attrs)
        try:
            fl = json.loads(htmllib.unescape(fm.group(1)).replace("\n", "")) if fm else {}
        except ValueError:
            fl = {}
        cond = re.search(r'class="hprt-table-cell hprt-table-cell-conditions[^"]*"(.*?)</td>', body, re.S)
        items = [strip_tags(x).split(" #policyModal")[0].lstrip("• ").strip()
                 for x in re.findall(r'<li[^>]*class="[^"]*bui-list__item[^"]*"[^>]*>(.*?)</li>',
                                     cond.group(1) if cond else "", re.S)]
        bed = re.search(r'class="hprt-roomtype-bed\s*"(.*?)</div>\s*</div>', body, re.S)
        if bed:
            last_beds = strip_tags(bed.group(1)).lstrip("> ").strip() or None
        rid = bid.split("_")[0]
        if rid != last_room and not bed:
            last_beds = None
        last_room = rid
        occ = re.search(r'class="hprt-table-cell hprt-table-cell-occupancy[^"]*"(.*?)</td>', body, re.S)
        ot = strip_tags(occ.group(1)) if occ else ""
        ma, mc = re.search(r"最多成人人數：\s*(\d+)", ot), re.search(r"最多兒童人數：\s*(\d+)", ot)
        oc = fl.get("occupancy_count") or {}
        rows[bid] = {"fit": oc.get("fit"), "conditions": [x for x in items if x], "beds": last_beds,
                     "max_adults": int(ma.group(1)) if ma else oc.get("max_adults"),
                     "max_children": int(mc.group(1)) if mc else 0}
    return rows


TIME_RE = r"(?:[上下]午|晚上|中午|凌晨|早上)?\s*\d{1,2}:\d{2}"


def policy_time(html, label):
    """'入住時間 下午4:00 後' / '退房時間 上午10:00 前' / '下午3:00 - 晚上11:00' from the policy block."""
    for m in re.finditer(">" + label, html):
        t = strip_tags(re.sub(r"<path[^>]*>|<svg.*?</svg>", " ", html[m.start() + 1:m.start() + 3000], flags=re.S))
        r = re.match(label + r"\s*(" + TIME_RE + r"(?:\s*[-－–至]\s*" + TIME_RE + r")?\s*[前後]?)", t)
        if r:
            return r.group(1).strip()
    return None


def parse_rate(bl, row, rooms, nights, currency):
    sp = {s.get("b_stays"): s for s in bl.get("b_stay_prices") or []}
    one = sp.get(rooms) or {}
    total = one.get("b_raw_price")
    total = float(total) if isinstance(total, (int, float, str)) and str(total).strip() not in ("", "0") else None
    pb = bl.get("b_price_breakdown_simplified") or {}
    ci = pb.get("b_charges_info_copy") or {}
    conds = (row or {}).get("conditions") or []
    canc = next((c for c in conds if "取消" in c or "退款" in c), None)
    pay = next((c for c in conds if "付款" in c or "預付" in c), None)
    left = bl.get("b_nr_stays")
    exc = pb.get("b_excluded_charges_amount")
    return {"rate_id": bl.get("b_block_id"),
            "price_total": rnd(total), "price_per_night": rnd(total / nights) if total else None,
            "currency": currency,
            "taxes_included": bool(ci.get("b_is_all_included")) or "含稅" in (ci.get("b_line_copy") or ""),
            "charges_note": ci.get("b_line_copy"),
            "excluded_charges": rnd(float(exc)) if exc else None,
            "breakfast": bl.get("b_mealplan_included_name") or None,
            "cancellation": canc or {"non_refundable": "不可退款", "free_cancellation": "免費取消"}.get(
                bl.get("b_cancellation_type"), bl.get("b_cancellation_type")),
            "free_cancel_before": zh_date(canc) if canc and "免費取消" in canc else None,
            "payment": pay,
            "max_guests": bl.get("b_max_persons"),
            "max_adults": (row or {}).get("max_adults"), "max_children": (row or {}).get("max_children"),
            "rooms_left": left,
            "fits_party": None,
            "bookable": bool(total) and (left is None or left >= rooms),
            "genius_rate": bool(bl.get("b_rate_is_genius"))}


def group_recommendation(html):
    """Booking's own suggested room set for this party: {block_id: rooms}. Read from the page's markup
    only (nr_rooms_<block>=N next to is_group_recommendation=1); that link is never requested."""
    for m in re.finditer(r"is_group_recommendation=1", html):
        seg = htmllib.unescape(htmllib.unescape(html[max(0, m.start() - 3000):m.start() + 1500]))
        got = {b: int(n) for b, n in re.findall(r"nr_rooms_([0-9]+_[0-9_]+)=(\d+)", seg) if int(n) > 0}
        if got:
            return got
    return {}


def parse_hotel_page(html, rooms, nights, currency, guests):
    ld = ld_json(html)
    agg = ld.get("aggregateRating") or {}
    addr = ld.get("address") or {}
    sm = re.search(r'data-testid="rating-(?:stars|squares|tiles)"[^>]*aria-label="[^"]*?(\d)', html) or \
        re.search(r'aria-label="[^"]*?(\d)[^"]*"[^>]*data-testid="rating-(?:stars|squares|tiles)"', html)
    kind = re.search(r'data-testid="rating-(stars|squares|tiles)"', html)
    cin, cout = policy_time(html, "入住時間"), policy_time(html, "退房時間")
    fac = re.search(r'data-testid="property-most-popular-facilities[^"]*"(.*?)</ul>', html, re.S)
    amen = []
    if fac:
        for li in re.findall(r"<li[^>]*>(.*?)</li>", fac.group(1), re.S):
            t = strip_tags(li)
            if t and t not in amen:
                amen.append(t)
    hid = re.search(r"\bb_hotel_id:\s*'?(\d+)", html)
    data = js_array(html, "b_rooms_available_and_soldout") or []
    rows = parse_hprt(html)
    group = group_recommendation(html)
    per_room = -(-guests // rooms)  # guests per room when the party is split evenly (children count, measured)
    out_rooms, fit_rates, unfit, rec = [], [], 0, []
    one_unit_ok = bool(group) and sum(group.values()) < rooms
    for rm in data:
        rates = []
        beds = None
        for bl in rm.get("b_blocks") or []:
            bid = bl.get("b_block_id")
            row = rows.get(bid)
            if row and row.get("beds") and not beds:
                beds = row["beds"]
            rt = parse_rate(bl, row, rooms, nights, currency)
            if bid in group:
                rec.append((bl, group[bid], rm))
            if rooms == 1:
                # the page's own flag (data-fltrs occupancy_count.fit), else b_can_fit_them_all
                fit = (row.get("fit") == 1) if row and row.get("fit") is not None else bool(bl.get("b_can_fit_them_all"))
                rt["fit_basis"] = "page"
            else:
                # multi-room: N of this room, party split evenly (Booking's page has no per-row fit flag then)
                fit = (bl.get("b_max_persons") or 0) >= per_room and rt["bookable"]
                rt["fit_basis"] = f"{rooms} x this room, {per_room} guest(s) each"
            if rooms > 1 and one_unit_ok and (bl.get("b_max_persons") or 0) >= guests:
                # Booking's own suggestion uses fewer units than --rooms (one apartment for everyone,
                # measured on 9616998), so a single unit that fits the whole party is a valid option too
                r1 = parse_rate(bl, row, 1, nights, currency)
                if r1["bookable"]:
                    r1.update(fit_basis="1 unit for the whole party (as Booking suggests)", fits_party=True,
                              booking_recommends=group.get(bid) == 1)
                    rates.append(r1)
                    fit_rates.append((r1, rm))
            rt["fits_party"] = fit
            rt["booking_recommends"] = bid in group
            if not fit:
                unfit += 1
                continue
            rates.append(rt)
            if rt["bookable"]:
                fit_rates.append((rt, rm))
        out_rooms.append({"room_id": str(rm.get("b_id")), "name": rm.get("b_name"), "beds": beds, "rates": rates})
    cheapest = min(fit_rates, key=lambda x: x[0]["price_total"]) if fit_rates else None
    recommended = None
    if rec:
        parts = [(parse_rate(bl, rows.get(bl.get("b_block_id")), n, nights, currency), n, rm) for bl, n, rm in rec]
        tot = sum(r["price_total"] for r, _, _ in parts) if all(r["price_total"] for r, _, _ in parts) else None
        recommended = {"rooms": [{"rate_id": r["rate_id"], "room": rm.get("b_name"), "count": n,
                                  "price_total": r["price_total"], "cancellation": r["cancellation"],
                                  "breakfast": r["breakfast"]} for r, n, rm in parts],
                       "price_total": tot, "price_per_night": rnd(tot / nights) if tot else None,
                       "units": sum(n for _, n, _ in parts)}
        if tot and (not cheapest or tot < cheapest[0]["price_total"]):
            # Booking's own set for this search is cheaper than N x one room (e.g. one apartment that
            # fits the whole party in a 2-room search): offer it, labelled.
            r0 = parts[0][0]
            name = " + ".join(str(n) + "× " + str(rm.get("b_name")) for _, n, rm in parts)
            cheapest = ({**r0, "price_total": tot, "price_per_night": recommended["price_per_night"],
                         "basis": "booking_recommendation",
                         "rate_id": "+".join(r["rate_id"] for r, _, _ in parts)}, {"b_name": name})
    return {"hotel_id": hid.group(1) if hid else None, "name": ld.get("name"),
            "stars": int(sm.group(1)) if sm else None,
            "stars_kind": ({"stars": "official"}.get(kind.group(1), "booking_estimate") if kind else None),
            "address": addr.get("streetAddress"), "rating": agg.get("ratingValue"), "reviews": agg.get("reviewCount"),
            "checkin_time": cin, "checkout_time": cout,
            "amenities": amen[:30], "rooms": [r for r in out_rooms if r["rates"]],
            "rates_hidden_not_fitting": unfit,
            "room_table_rows": len(rows), "sold_out": not cheapest,
            "booking_recommendation": recommended,
            "cheapest": None if not cheapest else {
                "room": (f"{rooms}× " if rooms > 1 and str(cheapest[0].get("fit_basis", "")).startswith(str(rooms))
                         else "") + str(cheapest[1].get("b_name")), **cheapest[0]}}


def resolve_hotel(cl, ref, args, nights):
    hid, path = parse_ref(ref)
    card = None
    if hid is not None:
        card = single_hotel_card(cl, hid, args, nights)
        if card and not path:
            path = (card["country"], card["page_name"])
    if not path:
        raise ApiError(f"hotel {hid} not found for these dates/party (Booking returned no card for it); "
                       "pass its booking.com/hotel/<cc>/<name>.html URL instead")
    return hid, path, card


def cmd_hotel(args):
    _, _, nights = stay(args)
    with Client(args) as cl:
        hid, (cc, pn), card = resolve_hotel(cl, args.ref, args, nights)
        url = hotel_url(cc, pn, args, cl.currency)
        info = parse_hotel_page(cl.get(url), args.rooms, nights, cl.currency, args.adults + len(args.children))
        if hid is not None and info["hotel_id"] and info["hotel_id"] != str(hid):
            raise ApiError(f"page {pn} is hotel {info['hotel_id']}, not {hid}")
        if card is None and info["hotel_id"]:
            card = single_hotel_card(cl, info["hotel_id"], args, nights)
    ch = info.get("cheapest")
    out = {"id": info["hotel_id"] or (str(hid) if hid else None), "checkin": args.checkin,
           "checkout": args.checkout, "nights": nights, "adults": args.adults, "children": args.children,
           "rooms_requested": args.rooms, **info,
           "search_card": None if not card else {"price_total": card["price_total"], "room": card["room"],
                                                 "free_cancellation": card["free_cancellation"]},
           "matches_search_card": bool(ch and card) and ch["price_total"] == card["price_total"],
           "price_basis": "price_total = the rate's stay total for ALL requested rooms and nights (b_stay_prices "
                          "for N rooms, the page's 總金額), taxes_included per the page's 含稅費與其他費用. "
                          "1 room: only rates the page marks as fitting this party (data-fltrs fit=1) are listed. "
                          "2+ rooms: N of the same room with the party split evenly (children count as guests), "
                          "plus Booking's own suggested set (booking_recommendation). rates_hidden_not_fitting "
                          "counts the others. search_card = the single-hotel search card for the same party; "
                          "booking_recommendation is the set Booking pre-selects (it can be a pricier flexible "
                          "rate, which is what district/city search cards show).",
           "url": url, "notes": cl.notes or None}

    def human():
        L = [f"{out.get('name') or out['id']}  ★{out.get('stars') or '?'}  {out.get('rating') or '?'}/10 "
             f"({out.get('reviews') or 0} reviews)",
             f"{out.get('address') or ''}",
             f"check-in {out.get('checkin_time') or '?'}  check-out {out.get('checkout_time') or '?'}",
             "amenities: " + (", ".join((out.get("amenities") or [])[:12]) or "-")]
        if ch:
            L.append(f"cheapest: {ch['room']} {money(ch['price_total'], cl.currency)} total "
                     f"({money(ch['price_per_night'], cl.currency)}/night) {ch.get('cancellation') or ''}"
                     f"  | search card {money((out['search_card'] or {}).get('price_total'), cl.currency) or '-'}")
        rec = out.get("booking_recommendation")
        if rec:
            L.append("Booking recommends: " + " + ".join(f"{x['count']}× {x['room']}" for x in rec["rooms"])
                     + f" = {money(rec['price_total'], cl.currency)}")
        if out.get("sold_out"):
            L.append("NO FITTING RATE for these dates/party/rooms")
        for rm in out["rooms"]:
            L.append(f"\n[{rm['room_id']}] {rm['name']}  {rm['beds'] or ''}")
            for rt in rm["rates"]:
                L.append(f"  {money(rt['price_total'], cl.currency):>11} total  {money(rt['price_per_night'], cl.currency)}"
                         f"/night  max {rt['max_adults'] if rt['max_adults'] is not None else rt['max_guests']}+{rt['max_children'] or 0}  {rt['breakfast'] or '不含餐'}  "
                         f"{rt['cancellation'] or ''}  {rt['payment'] or ''}  left {rt['rooms_left']}"
                         f"{'  Genius' if rt['genius_rate'] else ''}{'' if rt['taxes_included'] else '  +稅費?'}"
                         + (f"  [{rt.get('fit_basis')}]" if out["rooms_requested"] > 1 else ""))
        L.append(f"\n({out['rates_hidden_not_fitting']} rate(s) for smaller parties not shown)")
        return "\n".join(L)
    return emit(ok(out), args.json, human)


