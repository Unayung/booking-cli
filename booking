def cmd_raw(args):
    url = args.path if args.path.startswith("http") else ORIGIN + "/" + args.path.lstrip("/")
    u = urllib.parse.urlparse(url)
    if not (u.hostname or "").endswith("booking.com"):
        raise Usage("raw only talks to *.booking.com")
    if re.search(r"book|checkout|order|pay|reserv|hold|confirmation|cancel", u.path, re.I):
        raise Usage("raw refuses booking/checkout/order/payment/confirmation paths")
    with Client(args) as cl:
        code, text = cl.request("GET", url)
    try:
        body = json.loads(text)
    except ValueError:
        body = text[:20000]
    return emit(ok({"http": code, "url": url, "body": body}), True)


