WHO_Q = ("query BookingCliWho { personalProfile { __typename ... on Profile { personalData { firstName lastName } "
         "contactEmail { address } } } geniusMembership { __typename ... on GeniusMembership { geniusLevel } } }")


def mask_email(email):
    if not email or "@" not in email:
        return email
    user, dom = email.split("@", 1)
    return (user[:2] + "***" + user[-2:] if len(user) > 4 else user[:1] + "***") + "@" + dom


def account_info(cl):
    try:
        d = cl.gql(WHO_Q, {}, "BookingCliWho")
    except ApiError as e:
        # measured: without a session the profile service answers 403 inside the GraphQL errors
        raise Auth(f"session rejected by Booking.com ({str(e)[:120]}) - run `booking login`")
    pd = ((d.get("personalProfile") or {}).get("personalData") or {})
    if not pd.get("firstName") and not pd.get("lastName"):
        raise Auth("session rejected by Booking.com (no profile) - run `booking login`")
    g = (d.get("geniusMembership") or {}).get("geniusLevel")
    m = re.search(r"(\d+)", g or "")
    return {"logged_in": True, "name": " ".join(x for x in (pd.get("firstName"), pd.get("lastName")) if x),
            "email": mask_email(((d.get("personalProfile") or {}).get("contactEmail") or {}).get("address")),
            "genius_level": int(m.group(1)) if m else 0, "genius": g}


def fetch_csrf(cl):
    """x-booking-csrf-token for GraphQL mutations (the SSR pages carry it as csrfToken, a 24h JWT)."""
    tok = re.search(r'"csrfToken":"(eyJ[^"]+)"', cl.get(ORIGIN + "/index.zh-tw.html"))
    if tok:
        cl.st["csrf"] = tok.group(1)
    return bool(tok)


def login_from_browser(args):
    cookies, ua = edge_cookies()
    if signed_in(cookies):
        return cookies, ua
    br = Browser(ORIGIN + "/signin.zh-tw.html", debug=args.debug)
    try:
        print(f"Sign in to Booking.com in the new background tab of the browser on {CDP} (switch to it yourself; "
              f"this CLI never types passwords). Waiting up to {args.wait}s...", file=sys.stderr)
        t0 = time.time()
        while time.time() - t0 < args.wait:
            time.sleep(4)
            cookies, ua = edge_cookies()
            if signed_in(cookies):
                return cookies, ua
        raise Auth(f"not signed in after {args.wait}s; run `booking login` again")
    finally:
        br.close()


def _clipboard():
    for cmd in (["wl-paste", "-n"], ["pbpaste"], ["xclip", "-o", "-selection", "clipboard"]):
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (FileNotFoundError, subprocess.TimeoutExpired):
            continue
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    raise Auth("clipboard is empty or no clipboard tool (wl-paste / pbpaste / xclip)")


def _read_cookie_tty():
    import termios
    fd = sys.stdin.fileno()
    old, new = termios.tcgetattr(fd), termios.tcgetattr(fd)
    new[3] &= ~(termios.ICANON | termios.ECHO)
    new[6][termios.VMIN], new[6][termios.VTIME] = 1, 0
    print("paste the Cookie header, then press Enter (input hidden):", file=sys.stderr)
    buf = bytearray()
    try:
        termios.tcsetattr(fd, termios.TCSANOW, new)
        while True:
            ch = os.read(fd, 65536)
            if not ch:
                break
            if b"\x03" in ch:
                raise KeyboardInterrupt
            buf += ch
            if b"\r" in ch or b"\n" in ch:
                break
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)
        print(file=sys.stderr)
    return buf.decode("utf-8", "replace").splitlines()[0] if buf else ""


LOGIN_HOWTO = ("no Booking.com Cookie header found. In the browser: DevTools > Network > click any "
               "request to www.booking.com > Request Headers > copy the `Cookie:` value, "
               "then run `booking login` again (or pipe it in)")


def cmd_login(args):
    default = not (args.from_clipboard or args.cookie_stdin or args.from_browser)
    if default:
        try:
            raw = _clipboard() if sys.stdin.isatty() else sys.stdin.read()
            clean_cookie(raw)
        except Auth:
            raise Usage(LOGIN_HOWTO)
    if default or args.from_clipboard or args.cookie_stdin:
        if not default:
            raw = _clipboard() if args.from_clipboard else (_read_cookie_tty() if sys.stdin.isatty() else sys.stdin.read())
        cookies, ua = header_to_cookies(clean_cookie(raw)), os.environ.get("BOOKING_UA") or DEFAULT_UA
        src = "clipboard" if args.from_clipboard or (default and sys.stdin.isatty()) else "stdin"
    else:
        cookies, ua = login_from_browser(args)
        src = f"browser {CDP}"
    st = {"cookies": cookies, "ua": ua}
    with Client(argparse.Namespace(via="http", debug=args.debug, currency=args.currency), st) as cl:
        who = account_info(cl)
    st2 = load_state()
    st2.pop("source", None)
    if st2.get("keyring_parts"):
        keyring_clear(st2["keyring_parts"])
    for k in ("keyring_parts", "keyring_error"):
        st2.pop(k, None)
    st2.update(cookies=cookies, ua=ua, cookie_in_keyring=bool(args.keyring), user=who,
               logged_in_at=int(time.time()), login_source=src)
    if args.keyring:
        st2["keyring_parts"] = keyring_save(cookies)
        if keyring_load(st2["keyring_parts"]) != cookies:
            raise Auth("keyring did not return the session it was given; use the state file")
    save_state(st2)
    out = {"user": who, "stored": "keyring" if args.keyring else STATE_FILE, "cookies": len(cookies)}
    return emit(ok(out), args.json, lambda: f"signed in as {who.get('name')} {who.get('email') or ''} "
                f"(Genius {who.get('genius_level')}); session ({len(cookies)} cookies) saved to {out['stored']}")


def cmd_logout(args):
    st = load_state()
    if st.get("cookie_in_keyring"):
        keyring_clear(st.get("keyring_parts"))
    for k in ("cookies", "cookie_in_keyring", "keyring_parts", "keyring_error", "user", "logged_in_at",
              "login_source", "source", "ua", "csrf"):
        st.pop(k, None)
    save_state(st)
    return emit(ok({"logged_out": True}), args.json, "session removed (Edge is not touched)")


def need_session():
    st = load_state()
    if not signed_in(st.get("cookies")):
        raise Auth(st.get("keyring_error") or "not signed in - run `booking login`")
    return st


def cmd_whoami(args):
    st = need_session()
    with Client(args, st) as cl:
        who = account_info(cl)
    who["source"] = st.get("source")
    return emit(ok(who), args.json, lambda: (
        f"{who.get('name')}  {who.get('email') or ''}  Genius level {who.get('genius_level')}\n"
        f"session via {who['source']} (verified live on www.booking.com)"))


def cmd_doctor(args):
    checks = []
    st = load_state()
    checks.append(["state", "ok" if os.path.exists(STATE_FILE) else "-", STATE_FILE])
    try:
        ver = _http_json("/json/version")
        checks.append(["cdp", "ok", f"{CDP} {ver.get('Browser')} (login, WAF refresh, --via browser)"])
    except Net as e:
        checks.append(["cdp", "-", str(e)])
    if not any(c["name"] == "aws-waf-token" for c in st.get("cookies") or []):
        checks.append(["waf token", "-", "no aws-waf-token saved: run `booking login` (plain HTTPS without it gets "
                                         "the AWS WAF challenge, measured)"])
    with Client(argparse.Namespace(via=args.via, debug=args.debug, currency=args.currency), st) as cl:
        try:
            n = len(autocomplete(cl, "東京", 5))
            checks.append(["graphql", "ok" if n else "FAIL", f"AutoComplete 東京: {n} match(es)"])
        except (Net, ApiError, Auth) as e:
            checks.append(["graphql", "FAIL", str(e)])
        if signed_in(st.get("cookies")):
            try:
                who = account_info(cl)
                checks.append(["login", "ok", f"{who.get('name')} Genius {who.get('genius_level')} via {st.get('source')}"])
            except (Net, ApiError, Auth) as e:
                checks.append(["login", "FAIL", str(e)])
        else:
            checks.append(["login", "-", "not signed in: search works, but without Genius prices; trips/saved need "
                                         "`booking login`"])
        if cl.notes:
            checks.append(["notes", "ok", "; ".join(cl.notes)])
    bad = any(c[1] == "FAIL" for c in checks)
    payload = err("doctor found problems", EX_AUTH if checks[-1][1] == "FAIL" else EX_NET, checks=checks) \
        if bad else ok({"checks": checks})
    return emit(payload, args.json, lambda: table(checks, ["check", "state", "detail"]))


