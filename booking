TRIPS_Q = ("query UserTrips($first: Int, $after: String, $filter: UserTripFilterInput, $sortBy: TripSortOrder) { "
           "userTrips(first: $first, after: $after, filter: $filter, sortBy: $sortBy) { totalCount partialResults "
           "edges { node { id title { value } startDate endDate stage status itemCount "
           "bookedItemsCount { confirmed total } } } } }")
TRIP_FILTER = {"upcoming": {"tripFilter": "ACTIVE"}, "past": {"tripFilter": "PAST"},
               "cancelled": {"tripFilter": "CANCELLED"}, "all": None}


def trip_reservations(cl, tid):
    html = cl.get(f"{SECURE}/mytrips.zh-tw.html?tid={urllib.parse.quote(tid)}&tab=bookings")
    m = re.search(r'<script[^>]*data-capla-store-data="apollo"[^>]*>(.*?)</script>', html, re.S)
    if not m:
        return None
    store = json.loads(m.group(1))
    tl = ((store.get("ROOT_QUERY") or {}).get("singleTripTimelineQueries") or {})
    out = []
    for k, v in tl.items():
        if not k.startswith("singleTripTimeline"):
            continue
        for g in (v or {}).get("timelineGroups") or []:
            for it in g.get("tripItems") or []:
                r = it.get("reservation") or {}
                if it.get("type") != "RESERVATION" or not r:
                    continue
                prop = store.get(((r.get("propertyData") or {}).get("__ref")) or "", {}) or {}
                ids = r.get("identifiers") or {}
                out.append({"type": r.get("verticalType") or r.get("__typename"), "name": prop.get("name"),
                            "hotel_id": prop.get("id"), "city": (prop.get("location") or {}).get("city"),
                            "checkin": iso_day(r.get("startDateTime")), "checkout": iso_day(r.get("endDateTime")),
                            "status": r.get("reservationStatus"), "rooms": r.get("numOfRooms"),
                            "policy": (r.get("policy") or {}).get("name"),
                            "price": (r.get("price") or {}).get("amount"),
                            "price_currency": (r.get("price") or {}).get("currency"),
                            "price_user_currency": (r.get("userPriceWeb") or {}).get("userCurrencyPrice"),
                            "reservation_id": ids.get("hotelReservationId") or ids.get("publicId")})
    return out


def cmd_trips(args):
    st = need_session()
    with Client(args, st) as cl:
        d = cl.gql(TRIPS_Q, {"first": args.limit, "filter": TRIP_FILTER[args.status], "sortBy": "DATE_ASC"},
                   "UserTrips", host=SECURE)
        ut = d.get("userTrips") or {}
        trips = []
        for e in ut.get("edges") or []:
            n = e.get("node") or {}
            t = {"trip_id": n.get("id"), "title": (n.get("title") or {}).get("value"), "start": n.get("startDate"),
                 "end": n.get("endDate"), "stage": n.get("stage"), "status": n.get("status"),
                 "items": n.get("itemCount"), "booked": (n.get("bookedItemsCount") or {}).get("confirmed")}
            if not args.no_details and n.get("id"):
                try:
                    t["reservations"] = trip_reservations(cl, n["id"])
                except (ApiError, Blocked, ValueError) as ex:
                    t["reservations_error"] = str(ex)
            trips.append(t)
    out = {"status_filter": args.status, "total": ut.get("totalCount"), "count": len(trips), "trips": trips,
           "note": "read-only: secure.booking.com UserTrips + the trip page's own data (no auth keys printed)"}

    def human():
        L = []
        for t in trips:
            L.append(f"{t['start']}→{t['end']}  {t['title']}  {t['stage']}/{t['status']}  {t['booked']}/{t['items']} booked")
            for r in t.get("reservations") or []:
                L.append(f"    {r['reservation_id']}  {r['name']}  {r['checkin']}→{r['checkout']}  {r['status']}  "
                         f"{r['price_user_currency'] or ''} ({r['price']} {r['price_currency']})  {r['policy'] or ''}")
        return "\n".join(L) or "no trips"
    return emit(ok(out), args.json, human)


WL_Q = ("query BookingCliWishlists { wishlistService { userWishlist { __typename "
        "... on WishlistMultipleSuccessOutput { wishlists { listId name nbHotels lastChanged "
        "hotels { hotelId checkin checkout lastChanged } } } ... on WishlistFailResult { message } } } }")
WL_ADD = ("mutation saveHotelToWishlistV2($input: HotelInput) { wishlistService { saveHotelToWishlistV2(input: $input) "
          "{ __typename ... on WishlistSuccessOutput { wishlist { listId name nbHotels } } "
          "... on WishlistFailResult { message } } } }")
WL_RM = ("mutation removeHotelFromWishlistV2($input: HotelInput) { wishlistService { "
         "removeHotelFromWishlistV2(input: $input) { __typename ... on WishlistMultipleSuccessOutput { "
         "wishlists { listId name nbHotels } } ... on WishlistFailResult { message } } } }")


def wishlists(cl):
    d = cl.gql(WL_Q, {}, "BookingCliWishlists")
    uw = (d.get("wishlistService") or {}).get("userWishlist") or {}
    if uw.get("__typename") != "WishlistMultipleSuccessOutput":
        raise Auth(f"wishlist service refused: {uw.get('message') or uw.get('__typename')} (signed in?)")
    lists = []
    for w in uw.get("wishlists") or []:
        lists.append({"list_id": str(w.get("listId")), "name": w.get("name"), "hotels": w.get("nbHotels"),
                      "items": [{"id": str(h.get("hotelId")), "checkin": h.get("checkin"), "checkout": h.get("checkout")}
                                for h in w.get("hotels") or []]})
    ids = sorted({i["id"] for w in lists for i in w["items"]})
    return {"lists": lists, "hotel_ids": ids, "total": len(ids)}


def cmd_saved(args):
    st = need_session()
    cl = Client(argparse.Namespace(via=args.via, debug=args.debug, currency=args.currency), st)
    if args.action == "list":
        wl = wishlists(cl)
        return emit(ok(wl), args.json, lambda: "\n".join(
            f"[{w['list_id']}] {w['name']}: {w['hotels']} hotel(s) {' '.join(i['id'] for i in w['items'])}"
            for w in wl["lists"]) or "no wishlists")
    if not args.ref:
        raise Usage("saved add/rm needs a hotel id")
    hid, _ = parse_ref(args.ref)
    if hid is None:
        raise Usage("saved add/rm needs a numeric hotel id (see `booking search`)")
    hid = str(hid)
    before = wishlists(cl)
    is_saved = hid in before["hotel_ids"]
    want = args.action == "add"
    if is_saved == want:
        return emit(ok({"id": hid, "saved": is_saved, "changed": False}), args.json,
                    f"{hid} is already {'saved' if is_saved else 'not saved'}; nothing to do")
    if not args.yes:
        return emit(ok({"dry_run": True, "id": hid, "action": args.action, "currently_saved": is_saved,
                        "saved_total": before["total"], "lists": [w["name"] for w in before["lists"]]}), args.json,
                    f"would {args.action} {hid} (currently saved={is_saved}); re-run with --yes")
    fetch_csrf(cl)  # the page's own mutation header
    reply = None
    try:
        d = cl.gql(WL_ADD if want else WL_RM, {"input": {"hotelId": int(hid)}},
                   "saveHotelToWishlistV2" if want else "removeHotelFromWishlistV2", allow_errors=True)
        reply = ((d.get("wishlistService") or {}).get("saveHotelToWishlistV2" if want else
                                                     "removeHotelFromWishlistV2") or {}).get("__typename")
    except ApiError as e:
        reply = f"error: {e}"
    after = None
    for _ in range(5):  # never trust the mutation reply: re-read the real lists
        time.sleep(1.5)
        after = wishlists(cl)
        if (hid in after["hotel_ids"]) == want:
            break
    now = hid in after["hotel_ids"]
    if now != want:
        raise ApiError(f"{args.action} {hid}: the wishlist still says saved={now} (mutation reply {reply}) - "
                       "check `booking saved list`", {"saved_total": after["total"]})
    return emit(ok({"id": hid, "saved": now, "changed": True, "verified": "userWishlist re-read",
                    "mutation_reply": reply, "saved_total": after["total"],
                    "lists": [{"name": w["name"], "hotels": w["hotels"]} for w in after["lists"]]}), args.json,
                f"{hid} is now {'saved' if now else 'not saved'} (verified by re-reading the wishlists; "
                f"{after['total']} saved)")


# ------------------------------------------------------------------ parser
class Parser(argparse.ArgumentParser):
    def error(self, message):
        as_json = "--json" in sys.argv
        emit(err(f"{self.prog}: {message}", EX_USAGE), as_json)
        if not as_json:
            self.print_usage(sys.stderr)
        sys.exit(EX_USAGE)


def csv_ints(s):
    try:
        return [int(x) for x in str(s).split(",") if x.strip()]
    except ValueError:
        raise argparse.ArgumentTypeError(f"expected comma-separated numbers, got {s!r}")


def add_party(p):
    p.add_argument("--checkin", required=True)
    p.add_argument("--checkout", required=True)
    p.add_argument("--adults", type=int, default=2)
    p.add_argument("--children", type=csv_ints, default=[], help="ages, comma separated, e.g. 7,4")
    p.add_argument("--rooms", type=int, default=1)


def build_parser():
    p = Parser(prog="booking", description="Booking.com hotels (zh-tw, TWD) from the shell (no booking).")
    p.add_argument("--version", action="version", version=VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="stable {ok, data|error} envelope")
    common.add_argument("--debug", action="store_true", help="dump requests to stderr")
    common.add_argument("--via", choices=["auto", "http", "browser"], default="auto",
                        help="http = plain HTTPS with the saved cookies; browser = fetch inside a background Edge "
                             "tab; auto = http, and on an AWS WAF challenge refresh the token from Edge once")
    common.add_argument("--cdp", default=None, help=f"CDP endpoint (default {CDP})")
    common.add_argument("--currency", default="TWD", help="currency (default TWD; only TWD verified live)")
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=Parser)

    sub.add_parser("doctor", parents=[common], help="transport, API reachability, login state").set_defaults(fn=cmd_doctor)

    sg = sub.add_parser("suggest", parents=[common], help="typeahead / destination lookup")
    sg.add_argument("text")
    sg.add_argument("--limit", type=int, default=10)
    sg.set_defaults(fn=cmd_suggest)

    s = sub.add_parser("search", parents=[common], help="search hotels (prices = stay total for the party)")
    s.add_argument("destination", help="free text (resolved via typeahead) or <type>:<id>, e.g. district:2883")
    add_party(s)
    s.add_argument("--sort", choices=list(SORTS))
    s.add_argument("--page", type=int, default=1)
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--pool", type=int, default=100, help="price sorts: hotels read before re-sorting (default 100)")
    s.add_argument("--min", type=float, help="min price per night (stay total / nights), client-side")
    s.add_argument("--max", type=float, help="max price per night (stay total / nights), client-side")
    s.add_argument("--stars", type=csv_ints, default=[], help="e.g. 3,4")
    s.add_argument("--verify", action="store_true",
                   help="cheapest rate of every shown hotel via a single-hotel search (1 small call per row)")
    s.add_argument("--free-cancel", action="store_true")
    s.add_argument("--breakfast", action="store_true")
    s.add_argument("--include-nearby", action="store_true",
                   help="keep the hotels Booking adds from outside the destination (outside_area=true)")
    s.add_argument("--fresh", action="store_true", help=f"ignore the cached pool (reused {POOL_TTL // 60} min "
                   "so --page 2 continues the same list)")
    s.set_defaults(fn=cmd_search)

    h = sub.add_parser("hotel", aliases=["rooms"], parents=[common], help="rooms/rates for one hotel")
    h.add_argument("ref", help="hotel id or booking.com/hotel/<cc>/<name>.html URL")
    add_party(h)
    h.set_defaults(fn=cmd_hotel)

    pc = sub.add_parser("price", parents=[common], help="lowest fitting total for several hotels")
    pc.add_argument("refs", nargs="+")
    add_party(pc)
    pc.set_defaults(fn=cmd_price)

    lg = sub.add_parser("login", parents=[common], help="save a signed-in Booking.com session (default: Cookie header from stdin or clipboard)")
    g = lg.add_mutually_exclusive_group()
    g.add_argument("--from-browser", action="store_true", help="(opt-in) copy the session from Edge on CDP")
    g.add_argument("--from-clipboard", action="store_true", help="Cookie header from the clipboard")
    g.add_argument("--cookie-stdin", action="store_true", help="paste/pipe a Cookie header")
    lg.add_argument("--wait", type=int, default=300, help="seconds to wait for you to sign in")
    lg.add_argument("--keyring", action="store_true", help="store cookies in the OS keyring")
    lg.set_defaults(fn=cmd_login)
    sub.add_parser("logout", parents=[common], help="delete the saved session").set_defaults(fn=cmd_logout)
    sub.add_parser("whoami", parents=[common], help="verify the session live (name, email, Genius level)"
                   ).set_defaults(fn=cmd_whoami)

    t = sub.add_parser("trips", parents=[common], help="read-only list of your trips and reservations")
    t.add_argument("--status", default="all", choices=list(TRIP_FILTER))
    t.add_argument("--limit", type=int, default=10)
    t.add_argument("--no-details", action="store_true", help="skip the per-trip reservation page")
    t.set_defaults(fn=cmd_trips)

    sv = sub.add_parser("saved", parents=[common], help="wishlist (saved hotels) list/add/rm; no booking")
    sv.add_argument("action", choices=["list", "add", "rm"])
    sv.add_argument("ref", nargs="?", help="add/rm: hotel id")
    sv.add_argument("--yes", action="store_true", help="really write; without it only preview")
    sv.set_defaults(fn=cmd_saved)

    r = sub.add_parser("raw", parents=[common], help="GET passthrough for debugging (JSON out)")
    r.add_argument("path")
    r.set_defaults(fn=cmd_raw)
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if getattr(args, "cdp", None):
        _set_cdp(args.cdp)
    try:
        return args.fn(args)
    except Auth as e:
        return emit(err(str(e), EX_AUTH), args.json)
    except Net as e:
        return emit(err(str(e), EX_NET), args.json)
    except Usage as e:
        return emit(err(str(e), EX_USAGE), args.json)
    except ApiError as e:
        return emit(err(str(e), EX_ERR, **(e.detail or {})), args.json)
    except BrokenPipeError:
        return EX_OK
    except KeyboardInterrupt:
        return EX_ERR


if __name__ == "__main__":
    sys.exit(main())
