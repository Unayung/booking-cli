def _keyring(op, secret=None, acct="default"):
    try:
        if sys.platform == "darwin":
            cmd = {"set": ["security", "add-generic-password", "-U", "-a", acct, "-s", KEYRING_SERVICE, "-w", secret],
                   "get": ["security", "find-generic-password", "-a", acct, "-s", KEYRING_SERVICE, "-w"],
                   "del": ["security", "delete-generic-password", "-a", acct, "-s", KEYRING_SERVICE]}[op]
            r = subprocess.run(cmd, capture_output=True, text=True)
        else:
            base = ["service", KEYRING_SERVICE, "account", acct]
            cmd = {"set": ["secret-tool", "store", "--label=booking-cli"] + base,
                   "get": ["secret-tool", "lookup"] + base,
                   "del": ["secret-tool", "clear"] + base}[op]
            r = subprocess.run(cmd, input=secret if op == "set" else None, capture_output=True, text=True)
    except FileNotFoundError:
        raise Auth("no keyring tool (macOS `security` / Linux `secret-tool`)")
    if op == "get":
        return r.stdout.strip() if r.returncode == 0 else None
    if op == "set" and r.returncode != 0:
        raise Auth("keyring write failed: " + r.stderr.strip())
    return True


def keyring_save(cookies):
    blob = json.dumps(cookies, separators=(",", ":"))
    parts = [blob[i:i + KR_CHUNK] for i in range(0, len(blob), KR_CHUNK)]
    for i, part in enumerate(parts):
        _keyring("set", part, f"default.{i}")
    return len(parts)


def keyring_load(n):
    parts = [_keyring("get", acct=f"default.{i}") for i in range(n or 0)]
    if not n or any(p is None for p in parts):
        raise Auth("saved keyring session is missing - run `booking login --keyring`")
    try:
        return json.loads("".join(parts))
    except ValueError:
        raise Auth("saved keyring session is corrupt - run `booking login --keyring`")


def keyring_clear(n):
    for i in range(max(n or 0, 1)):
        _keyring("del", acct=f"default.{i}")
    _keyring("del")


def clean_cookie(raw):
    raw = (raw or "").strip()
    if raw.lower().startswith("cookie:"):
        raw = raw.split(":", 1)[1].strip()
    pairs = [p.strip() for p in raw.replace("\n", ";").split(";")]
    good_re = re.compile(r"^[!#$%&'*+.^_`|~0-9A-Za-z-]+=[\x21-\x7e]*$")
    good = [p for p in pairs if p and good_re.match(p)]
    if not any(p.split("=", 1)[0] in ("bkng_sso_auth", "bkng_sso_session") and len(p) > 16 for p in good):
        raise Auth("that does not look like a signed-in Booking.com Cookie header (no bkng_sso_auth). DevTools > "
                   "Network > a www.booking.com request > Request Headers > copy the value of `Cookie`")
    return "; ".join(good)


def header_to_cookies(header):
    return [{"name": p.split("=", 1)[0].strip(), "value": p.split("=", 1)[1].strip(), "domain": ".booking.com"}
            for p in header.split(";") if "=" in p]


def load_state():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            st = json.load(f)
    except FileNotFoundError:
        st = {}
    except (OSError, ValueError) as e:
        raise ApiError(f"state file unreadable: {e}")
    if os.environ.get("BOOKING_COOKIE"):
        st["cookies"], st["source"] = header_to_cookies(clean_cookie(os.environ["BOOKING_COOKIE"])), "env"
    elif st.get("cookie_in_keyring"):
        try:
            st["cookies"] = keyring_load(st.get("keyring_parts"))
        except Auth as e:
            st["cookies"], st["keyring_error"] = [], str(e)
        st["source"] = "keyring"
    elif st.get("cookies"):
        st["source"] = "file"
    return st


def save_state(st):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    out = {k: v for k, v in st.items() if k not in ("source", "keyring_error")}
    if out.get("cookie_in_keyring"):
        out.pop("cookies", None)
    tmp = STATE_FILE + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(out, f, ensure_ascii=False, indent=2)
    os.chmod(tmp, 0o600)
    os.replace(tmp, STATE_FILE)


def signed_in(cookies):
    return any(c["name"] in ("bkng_sso_auth", "bkng_sso_session") and c.get("value") for c in cookies or [])


def cookie_header(cookies, url):
    host = urllib.parse.urlparse(url).hostname or ""
    vals = {}
    for c in cookies or []:
        d = c.get("domain") or ".booking.com"
        if host == d.lstrip(".") or (d.startswith(".") and host.endswith(d)):
            if d.startswith(".") or c["name"] not in vals:
                vals[c["name"]] = c["value"]
    return "; ".join(f"{k}={v}" for k, v in vals.items())


def is_waf_challenge(code, text):
    return code == 202 or (code in (200, 202, 405) and "challenge.js" in text[:6000]
                           and "awsWafCookieDomainList" in text[:6000])


# -------------------------------------------------------------- transport
class Client:
    def __init__(self, args, st=None):
        self.args = args
        self.st = st if st is not None else load_state()
        self.debug = getattr(args, "debug", False)
        self.currency = (getattr(args, "currency", None) or "TWD").upper()
        self.via = getattr(args, "via", "auto")
        self.br = None
        self.ua = os.environ.get("BOOKING_UA") or self.st.get("ua") or DEFAULT_UA
        self._calls = 0
        self._waf_refreshed = False
        self.notes = []

    def __enter__(self):
        return self

    def __exit__(self, *a):
        if self.br:
            self.br.close()
            self.br = None

    def browser(self):
        if not self.br:
            self.br = Browser(debug=self.debug)
        return self.br

    def _http(self, method, url, body=None, headers=None):
        h = {"User-Agent": self.ua, "Accept-Language": "zh-TW,zh;q=0.9,en;q=0.8",
             "Accept": "text/html,application/xhtml+xml,application/json;q=0.9,*/*;q=0.8"}
        h.update(headers or {})
        ck = cookie_header(self.st.get("cookies"), url)
        if ck:
            h["Cookie"] = ck
        data = body.encode() if isinstance(body, str) else body
        if self.debug:
            print(f"> {method} {url} {(body or '')[:300] if isinstance(body, str) else ''}", file=sys.stderr)
        req = urllib.request.Request(url, data=data, headers=h, method=method)
        try:
            with urllib.request.urlopen(req, timeout=40) as r:
                code, text = r.status, r.read().decode("utf-8", "replace")
        except urllib.error.HTTPError as e:
            code, text = e.code, e.read().decode("utf-8", "replace")
        except OSError as e:
            raise Net(f"{urllib.parse.urlparse(url).netloc}: {e}")
        if self.debug:
            print(f"< {code} {len(text)} bytes {text[:200]!r}", file=sys.stderr)
        return code, text

    def _pace(self):
        if self._calls:
            time.sleep(PACE)
        self._calls += 1

    def _refresh_waf(self):
        """WAF token expired: take Edge's current token; if that is the same, let one background
        tab pass the challenge, then take the new token. Returns True if the token changed."""
        if self._waf_refreshed:
            return False
        self._waf_refreshed = True
        old = next((c["value"] for c in self.st.get("cookies") or [] if c["name"] == "aws-waf-token"), None)

        def edge_token():
            cks, _ = edge_cookies()
            return next((c for c in cks if c["name"] == "aws-waf-token"), None)
        try:
            tok = edge_token()
            if not tok or tok["value"] == old:
                with Browser(ORIGIN + "/index.zh-tw.html", debug=self.debug):
                    time.sleep(2)
                tok = edge_token()
        except Net as e:
            raise Blocked(f"Booking.com answered the AWS WAF challenge and Edge on {CDP} is not usable to refresh "
                          f"the token ({e})")
        if not tok or tok["value"] == old:
            return False
        cks = [c for c in self.st.get("cookies") or [] if c["name"] != "aws-waf-token"] + [tok]
        self.st["cookies"] = cks
        if self.st.get("source") == "file":
            st2 = load_state()
            st2["cookies"] = cks
            save_state(st2)
        self.notes.append("aws-waf-token refreshed from Edge")
        return True

    def request(self, method, url, body=None, headers=None):
        self._pace()
        if self.via == "browser":
            code, text = self.browser().fetch(method, url, body, headers)
        else:
            code, text = self._http(method, url, body, headers)
            if is_waf_challenge(code, text):
                if self.via == "auto" and self._refresh_waf():
                    code, text = self._http(method, url, body, headers)
                if is_waf_challenge(code, text):
                    raise Blocked(f"{urllib.parse.urlparse(url).path}: AWS WAF challenge (HTTP {code}); "
                                  "open booking.com once in Edge, then `booking login`")
        if code in (403, 429):
            raise Blocked(f"{urllib.parse.urlparse(url).path}: HTTP {code} (rate limit / bot wall)")
        return code, text

    def get(self, url):
        code, text = self.request("GET", url)
        if code >= 400:
            raise ApiError(f"{url.split('?')[0]}: HTTP {code}", {"http": code})
        return text

    def gql(self, query, variables=None, op=None, host=ORIGIN, allow_errors=False):
        url = f"{host}/dml/graphql?lang=zh-tw&selected_currency={self.currency}"
        body = json.dumps({"operationName": op, "variables": variables or {}, "query": query}, ensure_ascii=False)
        hdr = {"content-type": "application/json", "accept": "*/*", "apollographql-client-name":
               "b-search-web-searchresults", "x-booking-site-type-id": "1", "Origin": host,
               "Referer": host + "/index.zh-tw.html"}
        if self.st.get("csrf"):
            hdr["x-booking-csrf-token"] = self.st["csrf"]
        code, text = self.request("POST", url, body, hdr)
        try:
            d = json.loads(text)
        except ValueError:
            raise ApiError(f"graphql {op}: non-JSON reply (HTTP {code})", {"http": code, "body": text[:300]})
        if d.get("errors") and (not d.get("data") or not allow_errors):
            raise ApiError(f"graphql {op}: " + "; ".join(e.get("message", "?") for e in d["errors"])[:400],
                           {"http": code})
        return d.get("data") or {}


# --------------------------------------------------------------- helpers
def parse_date(s):
    try:
        return dt.date.fromisoformat(s)
    except Exception:
        raise Usage(f"bad date {s!r}, expected YYYY-MM-DD")


def stay(args):
    ci, co = parse_date(args.checkin), parse_date(args.checkout)
    if co <= ci:
        raise Usage("--checkout must be after --checkin")
    if args.adults < 1 or args.rooms < 1:
        raise Usage("--adults and --rooms must be >= 1")
    if args.rooms > args.adults:
        raise Usage("--rooms cannot exceed --adults")
    if any(a < 0 or a > 17 for a in args.children):
        raise Usage("--children ages must be 0..17")
    return ci, co, (co - ci).days


def party_qs(args, currency):
    q = [("checkin", args.checkin), ("checkout", args.checkout), ("group_adults", args.adults),
         ("group_children", len(args.children))]
    q += [("age", a) for a in args.children]
    q += [("no_rooms", args.rooms), ("selected_currency", currency), ("lang", "zh-tw")]
    return urllib.parse.urlencode(q)


def hotel_url(cc, page_name, args=None, currency="TWD"):
    u = f"{ORIGIN}/hotel/{cc}/{page_name}.zh-tw.html"
    return u + ("?" + party_qs(args, currency) if args else "")


def parse_ref(ref):
    """-> (hotel_id or None, (cc, page_name) or None)"""
    ref = str(ref).strip()
    if re.fullmatch(r"\d+", ref):
        return int(ref), None
    m = re.search(r"booking\.com/hotel/([a-z]{2})/([^/?#.]+)", ref)
    if m:
        hid = re.search(r"[?&;]hotel_?id=(\d+)", ref)
        return (int(hid.group(1)) if hid else None), (m.group(1), m.group(2))
    raise Usage(f"not a Booking.com hotel id or /hotel/<cc>/<name>.html URL: {ref!r}")


# --------------------------------------------------------------- suggest
AC_Q = ("query AutoComplete($input: AutoCompleteRequestInput!) { autoCompleteSuggestions(input: $input) { "
        "results { destination { countryCode destId destType latitude longitude } "
        "displayInfo { label title subTitle } } } }")


def autocomplete(cl, text, n=10):
    d = cl.gql(AC_Q, {"input": {"prefixQuery": text, "nbSuggestions": n}}, "AutoComplete")
    out = []
    for r in ((d.get("autoCompleteSuggestions") or {}).get("results") or []):
        de, di = r.get("destination") or {}, r.get("displayInfo") or {}
        if not de.get("destId"):
            continue
        out.append({"name": di.get("title"), "area": di.get("subTitle"), "label": di.get("label"),
                    "dest_type": de.get("destType"), "dest_id": str(de.get("destId")),
                    "country": de.get("countryCode")})
    return out


def cmd_suggest(args):
    with Client(args) as cl:
        items = autocomplete(cl, args.text, args.limit)
    return emit(ok({"query": args.text, "items": items}), args.json, lambda: table(
        [[f"{i['dest_type'].lower()}:{i['dest_id']}", i["name"], i["area"], i["country"]] for i in items],
        ["dest", "name", "area", "cc"]))


def resolve_destination(cl, dest):
    m = re.fullmatch(r"([a-zA-Z]+):(-?\d+)", str(dest).strip())
    if m:
        t = m.group(1).upper()
        if t not in DEST_TYPES:
            raise Usage(f"dest type must be one of {', '.join(x.lower() for x in DEST_TYPES)}")
        return {"dest_type": t, "dest_id": m.group(2), "name": dest, "search_string": None}
    if re.fullmatch(r"-?\d+", str(dest).strip()):
        raise Usage("a numeric destination needs its type, e.g. city:-240905 or district:2883 "
                    "(see `booking suggest`)")
    items = autocomplete(cl, dest, 5)
    if not items:
        raise ApiError(f"no destination matched {dest!r} (try `booking suggest {dest}`)")
    top = items[0]
    return {**top, "name": top["label"] or top["name"], "search_string": top["name"]}


